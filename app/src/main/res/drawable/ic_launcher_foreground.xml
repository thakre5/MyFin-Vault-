<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Operating Shard (Cyan to Blue) -->
    <path
        android:pathData="M 32,74 L 43,38 C 44,35 48,35 49,38 L 54,50 L 42,77 C 40,80 33,80 32,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="35"
                android:endX="54"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00D2EE"/>
                <item android:offset="1.0" android:color="#FF2563EB"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Fortress Shard (Teal to Emerald) -->
    <path
        android:pathData="M 76,74 L 65,38 C 64,35 60,35 59,38 L 54,50 L 66,77 C 68,80 75,80 76,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="76"
                android:startY="35"
                android:endX="54"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF34D399"/>
                <item android:offset="1.0" android:color="#FF0D9488"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Commitments Apex (Magenta to Violet) -->
    <path
        android:pathData="M 54,28 L 62,50 L 54,68 L 46,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="28"
                android:endX="54"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFA855F7"/>
                <item android:offset="1.0" android:color="#FF6C5CE7"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Core Vault Aperture -->
    <path
        android:pathData="M 54,50 m -9,0 a 9,9 0 1,1 18,0 a 9,9 0 1,1 -18,0"
        android:fillColor="#FF0F111E"/>

    <path
        android:pathData="M 54,50 m -5,0 a 5,5 0 1,1 10,0 a 5,5 0 1,1 -10,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="45"
                android:endX="54"
                android:endY="55"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF"/>
                <item android:offset="1.0" android:color="#FF00D2EE"/>
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M 54,50 m -10,0 a 10,10 0 1,1 20,0 a 10,10 0 1,1 -20,0"
        android:strokeWidth="1.2"
        android:strokeColor="#66FFFFFF"/>
</vector>
