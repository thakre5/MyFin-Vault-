        android:pathData="M 48,70 C 39,71 28,65 26,54 C 24,44 32,34 42,33 C 50,32 59,38 63,48 L 53,52 C 51,47 46,43 41,44 C 36,45 32,50 33,55 C 34,61 40,63 46,62 Z">
