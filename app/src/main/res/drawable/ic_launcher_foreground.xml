    <!-- Center Equilibrium Core (Lock Nucleus) -->
    <path
        android:pathData="M 54,54 m -5,0 a 5,5 0 1,1 10,0 a 5,5 0 1,1 -10,0"
        android:fillColor="#FF0B0C14"/>

