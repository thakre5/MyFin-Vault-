<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Canvas Background: Deep Obsidian Squircle -->
    <path
        android:pathData="M 28,0 L 80,0 A 28,28 0 0,1 108,28 L 108,80 A 28,28 0 0,1 80,108 L 28,108 A 28,28 0 0,1 0,80 L 0,28 A 28,28 0 0,1 28,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1A1C29"/>
                <item android:offset="0.6" android:color="#FF11121C"/>
                <item android:offset="1.0" android:color="#FF080911"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient Orbital Field Glow -->
    <path
        android:pathData="M 54,54 m -36,0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0"
        android:strokeWidth="1.2"
        android:strokeColor="#18FFFFFF"/>

    <!-- Ribbon 1: Operating Vault (Top Arc - Electric Cyan to Cobalt) -->
    <!-- Sweeps from bottom-left through apex to center-right twist -->
    <path
        android:pathData="M 39,63 C 33,52 34,35 44,25 C 52,17 64,18 70,25 C 76,33 76,46 68,55 L 59,48 C 64,42 64,34 60,30 C 56,26 49,26 45,31 C 39,37 38,48 43,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="18"
                android:endX="74"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00F5FF"/>
                <item android:offset="0.5" android:color="#FF00B4D8"/>
                <item android:offset="1.0" android:color="#FF1D4ED8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ribbon 2: Fortress Vault (Bottom-Right Arc - Mint to Deep Emerald) -->
    <!-- Sweeps from top-center down through bottom-right wing -->
    <path
        android:pathData="M 68,42 C 78,46 87,58 84,70 C 81,81 69,87 59,85 C 49,83 41,73 40,61 L 52,61 C 52,68 57,73 63,74 C 69,75 74,71 75,65 C 77,58 71,51 63,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="45"
                android:endX="86"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF34D399"/>
                <item android:offset="0.6" android:color="#FF10B981"/>
                <item android:offset="1.0" android:color="#FF047857"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ribbon 3: Commitments Vault (Bottom-Left Arc - Neon Violet to Deep Indigo) -->
    <!-- Locks the knot through the base and completes the continuous circuit -->
    <path
        android:pathData="M 48,72 C 38,73 26,67 24,54 C 21,43 30,32 41,31 C 50,30 61,37 65,48 L 54,53 C 52,47 46,42 40,43 C 34,44 29,50 30,56 C 31,63 38,65 45,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="30"
                android:endX="65"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFC084FC"/>
                <item android:offset="0.5" android:color="#FF8B5CF6"/>
                <item android:offset="1.0" android:color="#FF4338CA"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Equilibrium Core (Floating Nucleus) -->
    <path
        android:pathData="M 54,54 m -5.5,0 a 5.5,5.5 0 1,1 11,0 a 5.5,5.5 0 1,1 -11,0"
        android:fillColor="#FF0D0E17"/>

    <path
        android:pathData="M 54,54 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="51"
                android:startY="51"
                android:endX="57"
                android:endY="57"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF"/>
                <item android:offset="1.0" android:color="#FF00F5FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Optical Highlight on Core Edge -->
    <path
        android:pathData="M 54,54 m -6,0 a 6,6 0 1,1 12,0 a 6,6 0 1,1 -12,0"
        android:strokeWidth="0.8"
        android:strokeColor="#33FFFFFF"/>
</vector>
